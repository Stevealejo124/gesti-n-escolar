rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/usuarios/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function activeProfile() {
      return hasProfile() && get(userPath(request.auth.uid)).data.activo == true;
    }

    function isManagement() {
      return activeProfile()
        && get(userPath(request.auth.uid)).data.rol in ['direccion', 'admin'];
    }

    match /usuarios/{uid} {
      // La lectura propia no depende de consultas adicionales a reglas de dirección.
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if isManagement();
      allow create, update, delete: if activeProfile()
        && get(userPath(request.auth.uid)).data.rol == 'admin';
    }

    match /logs/{logId} {
      allow create: if activeProfile()
        && request.resource.data.keys().hasAll([
          'actorUid', 'actorName', 'type', 'section', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'actorUid', 'actorName', 'type', 'section', 'createdAt'
        ])
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName
          == get(userPath(request.auth.uid)).data.nombre
        && request.resource.data.type in ['login', 'logout', 'page_view']
        && request.resource.data.section
          in ['index', 'aportes', 'notas', 'horarios', 'fichas']
        && request.resource.data.createdAt == request.time;

      allow read: if isManagement();
      allow update, delete: if false;
    }

    // Denegación por defecto para notas, fichas, reportes y colecciones no definidas.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
